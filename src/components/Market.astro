---
import Section from './Section.astro';
import type { SectionProps } from '../types';

interface Props extends SectionProps {}
const { t } = Astro.props;
const { market } = t;
---

<Section id="market" eyebrow={market.eyebrow} title={market.title} lead={market.lead}>
  <div class="market-grid">
    {
      market.items.map((m) => (
        <article class="market-card reveal">
          <div class="market-card__tier">{m.tier}</div>
          <div class="market-card__value">{m.value}</div>
          <div class="market-card__label">{m.label}</div>
          <p class="market-card__desc">{m.desc}</p>
        </article>
      ))
    }
  </div>
</Section>
