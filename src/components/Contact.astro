---
import Section from './Section.astro';
import { EMAIL } from '../data/site';
import type { SectionProps } from '../types';

interface Props extends SectionProps {}
const { t } = Astro.props;
const { contact } = t;
const { form } = contact;
---

<Section id="contact" eyebrow={contact.eyebrow} title={contact.title} lead={contact.lead} soft>
  <div class="contact-grid">
    <div class="contact-direct reveal">
      <span class="contact-direct__label">{contact.directLabel}</span>
      <a class="contact-direct__email" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <p class="contact-direct__note">{contact.lead}</p>
    </div>

    <form class="contact-form reveal" id="inquiry" data-email={EMAIL}>
      <div class="field-row">
        <div class="field">
          <label for="f-name">{form.name}</label>
          <input id="f-name" name="name" type="text" placeholder={form.namePlaceholder} required />
        </div>
        <div class="field">
          <label for="f-org">{form.org}</label>
          <input id="f-org" name="org" type="text" placeholder={form.orgPlaceholder} required />
        </div>
      </div>
      <div class="field">
        <label for="f-type">{form.type}</label>
        <select id="f-type" name="type">
          {form.types.map((ty) => <option value={ty}>{ty}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="f-msg">{form.message}</label>
        <textarea id="f-msg" name="message" placeholder={form.messagePlaceholder} required></textarea>
      </div>
      <button class="btn btn--primary" type="submit">{form.submit}</button>
    </form>
  </div>
</Section>

<script>
  const formEl = document.getElementById('inquiry') as HTMLFormElement | null;
  formEl?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = formEl.dataset.email ?? '';
    const data = new FormData(formEl);
    const name = String(data.get('name') ?? '');
    const org = String(data.get('org') ?? '');
    const type = String(data.get('type') ?? '');
    const message = String(data.get('message') ?? '');
    const subject = `[${type}] ${org} / ${name}`;
    const body = `${message}\n\n---\n${name} · ${org}`;
    window.location.href =
      `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
