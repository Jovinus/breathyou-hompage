---
import Section from './Section.astro';
import type { SectionProps } from '../types';

interface Props extends SectionProps {}
const { t } = Astro.props;
const { roadmap } = t;
---

<Section id="roadmap" eyebrow={roadmap.eyebrow} title={roadmap.title} soft>
  <div class="roadmap-grid">
    {
      roadmap.phases.map((p) => (
        <article class="phase reveal">
          <div class="phase__head">
            <span class="phase__period">{p.period}</span>
            <span class="phase__name">{p.name}</span>
          </div>
          <ul>
            {p.items.map((it) => (
              <li>{it}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <div class="roadmap-global reveal">
    <span class="roadmap-global__label">{roadmap.global.label}</span>
    <p class="roadmap-global__text">{roadmap.global.text}</p>
  </div>
</Section>
