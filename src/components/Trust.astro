---
import type { SectionProps } from '../types';

interface Props extends SectionProps {}
const { t } = Astro.props;
const { hero, ui } = t;
---

<section class="proof-strip" aria-label={ui.keyMetrics}>
  <div class="container proof-strip__grid">
    {
      hero.stats.map((s) => (
        <div class="proof-item reveal">
          <strong>{s.value}</strong>
          <span>{s.label}</span>
        </div>
      ))
    }
  </div>
</section>
