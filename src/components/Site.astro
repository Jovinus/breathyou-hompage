---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Trust from './Trust.astro';
import Problem from './Problem.astro';
import Solution from './Solution.astro';
import Research from './Research.astro';
import Advantage from './Advantage.astro';
import Growth from './Growth.astro';
import Team from './Team.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import type { SectionProps } from '../types';

interface Props extends SectionProps {}
const { t } = Astro.props;
---

<Base t={t}>
  <Nav t={t} />
  <main id="main">
    <Hero t={t} />
    <Trust t={t} />
    <Problem t={t} />
    <Solution t={t} />
    <Research t={t} />
    <Advantage t={t} />
    <Growth t={t} />
    <Team t={t} />
    <Contact t={t} />
  </main>
  <Footer t={t} />
</Base>
