---
import type { Content } from '../data/content';

interface Props {
  t: Content;
}
const { t } = Astro.props;
const { hero } = t;
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <div class="hero__content reveal">
      <span class="hero__badge"><span class="dot"></span>{hero.badge}</span>
      <h1>{hero.title}</h1>
      <p class="hero__lead">{hero.lead}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#contact">{hero.primaryCta}</a>
        <a class="btn btn--ghost" href="#solution">{hero.secondaryCta}</a>
      </div>
    </div>

    <aside class="hero__card reveal" aria-label="핵심 지표">
      {
        hero.stats.map((s) => (
          <div class="hero__stat">
            <div class="v">{s.value}</div>
            <div class="l">{s.label}</div>
          </div>
        ))
      }
    </aside>
  </div>
</section>
