---
import type { SectionProps } from '../types';

interface Props extends SectionProps {}
const { t } = Astro.props;
const { hero } = t;
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <div class="hero__content reveal">
      <span class="hero__badge"><span class="dot"></span>{hero.badge}</span>
      <h1>{hero.title}</h1>
      <p class="hero__lead">{hero.lead}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#contact">{hero.primaryCta}</a>
        <a class="btn btn--ghost" href="#solution">{hero.secondaryCta}</a>
      </div>
      <p class="hero__note"><span aria-hidden="true"></span>{hero.note}</p>
    </div>

    <figure class="hero-product reveal" aria-labelledby="hero-product-title">
      <div class="hero-product__bar">
        <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
        <figcaption id="hero-product-title">{hero.visual.label}</figcaption>
        <span class="hero-product__live">{hero.visual.live}</span>
      </div>

      <div class="hero-product__body">
        <div class="medipipe-stage medipipe-stage--input">
          <span class="medipipe-stage__no">01 · {hero.visual.inputLabel}</span>
          <strong>{hero.visual.input}</strong>
          <small>{hero.visual.inputMeta}</small>
          <div class="source-files" aria-label={hero.visual.input}>
            {
              hero.visual.sources.map((source) => (
                <div class="source-file">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6.5 3.5h7l4 4v13h-11z" />
                    <path d="M13.5 3.5v4h4M9 12h6M9 15.5h4.5" />
                  </svg>
                  <span>{source}</span>
                </div>
              ))
            }
          </div>
        </div>

        <span class="medipipe-arrow" aria-hidden="true">→</span>

        <div class="medipipe-stage medipipe-stage--engine">
          <div class="medipipe-engine__head">
            <span class="medipipe-engine__mark" aria-hidden="true">M</span>
            <span>
              <small>02 · MEDIPIPE</small>
              <strong>{hero.visual.processing}</strong>
            </span>
          </div>
          <ol class="medipipe-engine__steps">
            {hero.visual.processingSteps.map((step) => <li>{step}</li>)}
          </ol>
          <div class="medipipe-engine__secure">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="5" y="10" width="14" height="10" rx="2" />
              <path d="M8 10V7a4 4 0 0 1 8 0v3" />
            </svg>
            {hero.visual.processingMeta}
          </div>
        </div>

        <span class="medipipe-arrow" aria-hidden="true">→</span>

        <div class="medipipe-stage medipipe-stage--output">
          <span class="medipipe-stage__no">03 · {hero.visual.outputLabel}</span>
          <div class="structured-data__head">
            <span>
              <strong>{hero.visual.output}</strong>
              <small>{hero.visual.outputMeta}</small>
            </span>
            <span class="structured-data__status">{hero.visual.outputValue}</span>
          </div>
          <div class="structured-data">
            {
              hero.visual.outputRows.map((row) => (
                <div class="structured-data__row">
                  <span>{row.label}</span>
                  <strong>{row.value}</strong>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 12 4 4 8-8" /></svg>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="hero-product__foot">
        <span class="hero-product__foot-dot" aria-hidden="true"></span>
        <strong>{hero.visual.explain}</strong>
        <div class="hero-product__destinations" aria-label={hero.visual.explain}>
          {hero.visual.destinations.map((destination) => <span>{destination}</span>)}
        </div>
      </div>
    </figure>
  </div>
</section>
