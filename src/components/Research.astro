---
import Section from './Section.astro';
import type { SectionProps } from '../types';

interface Props extends SectionProps {}
const { t } = Astro.props;
const { research } = t;
---

<Section id="research" eyebrow={research.eyebrow} title={research.title} lead={research.lead}>
  <div class="module-grid">
    {
      research.modules.map((m) => (
        <article class="card product module reveal">
          <div class="product__head">
            <span class="product__status">{m.status}</span>
          </div>
          <h3>{m.name}</h3>
          <p class="module__tag">{m.tag}</p>
          <p class="module__value">{m.value}</p>
          <p class="module__label">{m.valueLabel}</p>
          <ul class="product__points">
            {m.points.map((pt) => <li>{pt}</li>)}
          </ul>
        </article>
      ))
    }
  </div>

  <div class="trigger reveal">
    <span class="trigger__label">{research.scale.label}</span>
    <p class="trigger__text">{research.scale.text}</p>
  </div>

  <div class="metric-list reveal">
    {
      research.metrics.map((m, index) => (
        <div class="metric">
          <span class="metric__no">0{index + 1}</span>
          <span class="v">{m.value}</span>
          <span class="l">{m.label}</span>
        </div>
      ))
    }
  </div>
  <p class="metric-list__note reveal">{research.metricsNote}</p>

  <div class="awards reveal">
    <span class="awards__label">{research.awardsLabel}</span>
    {
      research.awards.map((a) => (
        <div class="award">
          <span class="award__badge">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="9" r="6" />
              <path d="M8.5 14.5 7 22l5-3 5 3-1.5-7.5" />
            </svg>
            {a.badge}
          </span>
          <div class="award__body">
            <p class="award__title">{a.title}</p>
            <p class="award__host">{a.host}</p>
          </div>
        </div>
      ))
    }
  </div>

  <div class="research-grid">
    <div class="research-story reveal">
      <span class="research-story__label">{research.credLabel}</span>
      <p>{research.credText}</p>
      <ul class="research-story__points">
        {research.credPoints.map((point) => <li>{point}</li>)}
      </ul>
      <div class="research-story__signal" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>

    <div class="papers reveal">
      <p class="papers__title">{research.papersTitle}</p>
      {
        research.papers.map((p) => (
          <div class="paper">
            <p class="paper__title">{p.title}</p>
            <div class="paper__meta">
              <span class="paper__venue">{p.venue}</span>
              <span class="paper__year">{p.year}</span>
            </div>
          </div>
        ))
      }
      <a class="papers__link" href={research.papersLink.href} target="_blank" rel="noopener">
        {research.papersLink.label} →
      </a>
    </div>
  </div>
</Section>
