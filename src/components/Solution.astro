---
import Section from './Section.astro';
import type { SectionProps } from '../types';

interface Props extends SectionProps {}
const { t } = Astro.props;
const { solution } = t;
---

<Section id="solution" eyebrow={solution.eyebrow} title={solution.title} lead={solution.lead} soft>
  <ol class="workflow reveal" aria-label={solution.workflowLabel}>
    {
      solution.workflow.map((step) => (
        <li class="workflow__step">
          <span class="workflow__no">{step.no}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <figure class="product-shot reveal">
    <a class="product-shot__frame" href={solution.screenshot.src2x} target="_blank" rel="noopener">
      <img
        src={solution.screenshot.src}
        srcset={`${solution.screenshot.src} 1x, ${solution.screenshot.src2x} 2x`}
        width={solution.screenshot.width}
        height={solution.screenshot.height}
        alt={solution.screenshot.alt}
        loading="lazy"
        decoding="async"
      />
    </a>
    <figcaption>
      <p class="product-shot__caption">{solution.screenshot.caption}</p>
      <p class="product-shot__zoom">{solution.screenshot.zoomHint}</p>
      <p class="product-shot__note">{solution.screenshot.note}</p>
    </figcaption>
  </figure>

  <div class="checks reveal">
    <span class="checks__label">{solution.checks.label}</span>
    <h3 class="checks__title">{solution.checks.title}</h3>
    <p class="checks__lead">{solution.checks.lead}</p>
  </div>
  <div class="grid-3">
    {
      solution.checks.items.map((it) => (
        <article class="card problem-card reveal">
          <div class="no">{it.no}</div>
          <h3>{it.title}</h3>
          <p>{it.text}</p>
        </article>
      ))
    }
  </div>
  <p class="checks__note reveal">{solution.checks.note}</p>
</Section>
