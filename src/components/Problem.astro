---
import Section from './Section.astro';
import type { SectionProps } from '../types';

interface Props extends SectionProps {}
const { t } = Astro.props;
const { problem } = t;
---

<Section id="problem" eyebrow={problem.eyebrow} title={problem.title}>
  <div class="trigger reveal">
    <span class="trigger__label">{problem.trigger.label}</span>
    <p class="trigger__text">{problem.trigger.text}</p>
  </div>

  <div class="grid-3">
    {
      problem.items.map((it) => (
        <article class="card problem-card reveal">
          <div class="no">{it.no}</div>
          <h3>{it.title}</h3>
          <p>{it.text}</p>
        </article>
      ))
    }
  </div>
</Section>
