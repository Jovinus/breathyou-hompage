---
import type { Content } from '../data/content';

interface Props {
  t: Content;
}
const { t } = Astro.props;
const { problem } = t;
---

<section class="section" id="problem">
  <div class="container">
    <div class="reveal">
      <span class="eyebrow">{problem.eyebrow}</span>
      <h2 class="section-title">{problem.title}</h2>
    </div>

    <div class="trigger reveal">
      <span class="trigger__label">{problem.trigger.label}</span>
      <p class="trigger__text">{problem.trigger.text}</p>
    </div>

    <div class="grid-3">
      {
        problem.items.map((it) => (
          <article class="card problem-card reveal">
            <div class="no">{it.no}</div>
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
