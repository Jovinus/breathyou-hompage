---
import Section from './Section.astro';
import type { SectionProps } from '../types';

interface Props extends SectionProps {}
const { t } = Astro.props;
const { team } = t;
---

<Section id="team" eyebrow={team.eyebrow} title={team.title} lead={team.lead}>
  <div class="team-grid">
    {
      team.members.map((m) => (
        <article class="member reveal">
          <div class="member__head">
            {m.photo ? (
              <img
                class="member__photo"
                src={m.photo}
                alt={m.name}
                width="112"
                height="112"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="member__photo member__photo--initial" aria-hidden="true">
                {m.name.trim().charAt(0)}
              </div>
            )}
            <div>
              <div class="member__name">{m.name}</div>
              <div class="member__sub">{m.sub}</div>
              <span class="member__role">{m.role}</span>
            </div>
          </div>
          <p class="member__bio">{m.bio}</p>
          <ul class="member__highlights">
            {m.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
        </article>
      ))
    }
  </div>

  <div class="partners reveal">
    <div class="partners__head">
      <span class="partners__label">{team.partners.label}</span>
      <p class="partners__text">{team.partners.text}</p>
    </div>
    <div class="partners__grid">
      {
        team.partners.items.map((partner) => (
          <article class:list={['partner-card', { 'partner-card--featured': partner.featured }]}>
            <strong>{partner.name}</strong>
            <span>{partner.note}</span>
          </article>
        ))
      }
    </div>
  </div>
</Section>
